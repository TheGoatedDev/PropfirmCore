{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!pnpm-lock.yaml",
            "!node_modules",
            "!.turbo",
            "!dist",
            "!coverage",
            "!playwright-report",
            "!test-results",
            "!packages/api-client/openapi.json",
            "!packages/api-client/src/schema.ts",
            "!apps/server/drizzle",
            "!**/routeTree.gen.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "style": {
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "recharts": "Charts use TanStack Charts (@tanstack/charts). shadcn/ui charts and Recharts are not allowed; see DESIGN.md \u203a Charts.",
                            "react-charts": "Use @tanstack/charts/react, not the old react-charts beta.",
                            "@tanstack/react-charts": "Compatibility package only; import Chart from @tanstack/charts/react."
                        }
                    }
                }
            }
        }
    },
    "overrides": [
        {
            "includes": ["packages/ui/src/components/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noLabelWithoutControl": "off"
                    }
                }
            }
        }
    ]
}
