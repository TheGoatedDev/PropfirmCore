{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!pnpm-lock.yaml",
            "!node_modules",
            "!.turbo",
            "!dist",
            "!coverage",
            "!playwright-report",
            "!test-results",
            "!packages/api-client/openapi.json",
            "!packages/api-client/src/schema.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "overrides": [
        {
            "includes": ["packages/ui/src/components/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noLabelWithoutControl": "off"
                    }
                }
            }
        }
    ]
}
