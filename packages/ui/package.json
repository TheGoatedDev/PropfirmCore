{
    "name": "@propfirmcore/ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#lib/*": "./src/lib/*.ts",
        "#hooks/*": "./src/hooks/*.ts"
    },
    "exports": {
        "./globals.css": "./src/styles/globals.css",
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@base-ui/react": "1.7.0",
        "@tanstack/react-table": "9.2.4",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.38.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "3.6.0"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.5",
        "typescript": "7.0.2"
    }
}
