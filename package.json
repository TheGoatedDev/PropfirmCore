{
    "name": "propfirmcore",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@11.24.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "docker compose -f infra/compose.yaml up -d --wait && turbo run dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "test": "vitest run",
        "e2e": "playwright test",
        "ingest-load": "pnpm --filter @propfirmcore/ingest-load start",
        "lint": "biome check .",
        "format": "biome check --write .",
        "actionlint": "actionlint",
        "deps:check": "syncpack lint",
        "deps:pin": "syncpack fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@playwright/test": "1.62.1",
        "@biomejs/biome": "2.5.11",
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "husky": "9.1.7",
        "lint-staged": "17.4.1",
        "syncpack": "15.3.3",
        "turbo": "2.10.12",
        "typescript": "7.0.2",
        "vite": "8.2.2",
        "vitest": "4.1.11"
    },
    "lint-staged": {
        "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    }
}
