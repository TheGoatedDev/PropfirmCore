        "@propfirmcore/config": "workspace:*",
        "@propfirmcore/domain": "workspace:*",
        "bullmq": "6.3.2",
        "drizzle-orm": "0.45.2",
        "hono": "4.13.5",
        "ioredis": "6.0.0",
        "postgres": "3.4.9",
        "tsx": "4.23.13",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@types/node": "24.10.0",
        "typescript": "7.0.2"
    }
