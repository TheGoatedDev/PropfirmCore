{
    "name": "@propfirmcore/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:worker": "tsx watch --env-file=../../.env.example src/worker.ts",
        "start": "tsx src/api.ts",
        "start:worker": "tsx src/worker.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "openapi": "tsx src/export-openapi.ts",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.7.2",
        "@hono/node-server": "2.1.1",
        "@hono/zod-openapi": "1.6.1",
        "@nats-io/jetstream": "3.4.0",
        "@nats-io/transport-node": "3.4.0",
        "@propfirmcore/config": "workspace:*",
        "@propfirmcore/domain": "workspace:*",
        "@t3-oss/env-core": "0.13.11",
        "better-auth": "1.7.2",
        "drizzle-orm": "0.45.2",
        "hono": "4.13.5",
        "luxon": "3.7.2",
        "pino": "10.3.1",
        "pino-pretty": "13.1.3",
        "postgres": "3.4.9",
        "tsx": "4.23.13",
        "zod": "4.5.4"
    },
    "devDependencies": {
        "@types/luxon": "3.7.5",
        "@types/node": "24.10.0",
        "drizzle-kit": "0.31.10",
        "typescript": "7.0.2"
    }
}
