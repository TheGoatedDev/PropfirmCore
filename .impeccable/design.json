  "narrative": {
    "northStar": "The Back Office",
    "overview": "PropfirmCore is the room behind the counter. It ships to many prop firms, and each one puts its own name on the trader-facing door. The system is unbranded on purpose: gray surfaces, system type, and no logo beyond a placeholder glyph. What carries the identity is the firm brand on top and the precision of the operations underneath. The system is compact and precise. The current palette is a placeholder, not a position.",
    "keyCharacteristics": [
      "Unbranded white-label canvas, with the firm brand layered on top",
      "Achromatic oklch neutral ramp. Red is the only hue.",
      "Compact controls with a 32px default height",
      "Flat surfaces: a hairline ring instead of shadows",
      "System sans throughout, no custom fonts",
      "One shell for both apps: collapsible sidebar, breadcrumb title bar, floating header on scroll"
    ],
    "rules": [
      {
        "name": "The Placeholder Palette Rule",
        "section": "colors",
        "body": "Gray is provisional. Do not add a hue in a single screen. Status and accent colors enter the system as named tokens in globals.css, and only there."
      },
      {
        "name": "The Red Is Destructive Rule",
        "section": "colors",
        "body": "Signal Red means \"this deletes, fails, or is invalid\". Do not reuse it for decoration, emphasis, or negative P&L until a status palette exists."
      },
      {
        "name": "The Crumb Is the Title Rule",
        "section": "typography",
        "body": "The breadcrumb last item (staticData.crumb) is the page title. No heading in the main content may repeat it."
      },
      {
        "name": "The Fourteen Pixel Rule",
        "section": "typography",
        "body": "Operational text is 0.875rem. Add size only for structure, never for emphasis inside a table."
      },
      {
        "name": "The 32px Rule",
        "section": "layout",
        "body": "The default interactive height is 32px. Go to 28px only inside dense rows. Never exceed 36px in the apps."
      },
      {
        "name": "The Ring Not Shadow Rule",
        "section": "elevation",
        "body": "Containers separate with a hairline ring or border. A shadow means \"this floats above scrolling content\"."
      }
    ],
    "dos": [
      "Do take every color from a token in packages/ui/src/styles/globals.css, and define new status or accent colors there first.",
      "Do keep interactive controls at 32px (the default size) and text at 0.875rem.",
      "Do separate containers with the hairline ring or border, not shadows.",
      "Do build both apps from @propfirmcore/ui components. Add a missing primitive to the package, not to an app.",
      "Do pair every status with a text label (badge text, cell text). Pass, fail, warn and flag carry money consequences.",
      "Do check every new surface in both light and dark themes."
    ],
    "donts": [
      "Don't add ad-hoc Tailwind palette colors (green-600, amber-100, …) in app code. The palette is a placeholder, and status colors are an open token decision.",
      "Don't render a heading that repeats the breadcrumb page title.",
      "Don't nest a Card (or any card-like surface) inside another Card.",
      "Don't use Signal Red for anything other than destructive, failed or invalid.",
      "Don't put PropfirmCore branding on trader-facing surfaces. The brand slot belongs to the firm.",
      "Don't add web fonts or a display type tier to operational screens."
    ]
  }
}
